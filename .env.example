# Existing CAFY client configuration. Copy to .env.local for local development.
# Reuse the Firebase project/account used by ProductBackend and Resume Studio.
# Values with VITE_ are public browser configuration: never put AI/service keys here.
VITE_BACKEND_URL=http://localhost:5000
VITE_RESUME_STUDIO_URL=http://localhost:3000

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# In production use the deployed API URL; omit VITE_RESUME_STUDIO_URL to use
# https://resume.cafy.careers. Existing observability/billing client settings
# should be retained from your current deployment.
